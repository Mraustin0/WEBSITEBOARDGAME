NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/boardgame-everyday
JWT_SECRET=change-me-to-a-long-random-string-please
# หลาย origin คั่นด้วย , (dev อนุญาต localhost:5173/5174 ให้อัตโนมัติ)
CLIENT_ORIGIN=http://localhost:5173
# จำนวน reverse proxy ข้างหน้า server (0 = ไม่มี, เช่น Render/Railway = 1)
TRUST_PROXY=0
LOG_LEVEL=info
BGG_TOKEN=
